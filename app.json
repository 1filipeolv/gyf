{
  "expo": {
    "name": "GymApp",
    "slug": "gymapp",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.filipesxn.gymapp"
    },
    "android": {
      "package": "com.filipesxn.gymapp",
      "versionCode": 3,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso às fotos para registrar seu progresso.",
          "cameraPermission": "Permitir uso da câmera para fotos de progresso."
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#7C5CFF"
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "e7f69aca-e80a-4c86-91f5-1a75095fb3e8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e7f69aca-e80a-4c86-91f5-1a75095fb3e8"
    }
  }
}
